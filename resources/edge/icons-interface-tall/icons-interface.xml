<!--
    Override interface icon sizes for tall Edge devices (Edge Explore 2, 1040, 1050, ...)
-->
<drawables xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    
    <!--
        The connection mode icons all have the same height but different widths.
        Therefore, they must be scaled relative to the screen height rather than the screen width.

        To achieve a consistent visual size on both short and tall devices,
        the icon sizes must be defined differently for each device type.
    -->
    <bitmap id="iconBluetoothOn" scaleY="4%" filename="../../icons-interface/connectivity/bluetooth-on.svg" dithering="none" />
    <bitmap id="iconBluetoothOff" scaleY="4%" filename="../../icons-interface/connectivity/bluetooth-off.svg" dithering="none" />
    <bitmap id="iconWifiCheck" scaleY="4%" filename="../../icons-interface/connectivity/wifi-check.svg" dithering="none" />
    <bitmap id="iconWifiOn" scaleY="4%" filename="../../icons-interface/connectivity/wifi-on.svg" dithering="none" />
    <bitmap id="iconWifiOff" scaleY="4%" filename="../../icons-interface/connectivity/wifi-off.svg" dithering="none" />
    <bitmap id="iconConnStateGreen" scaleY="4%" filename="../../icons-interface/connectivity/state-green.svg" dithering="none" />
    <bitmap id="iconConnStateYellow" scaleY="4%" filename="../../icons-interface/connectivity/state-yellow.svg" dithering="none" />
    <bitmap id="iconConnStateRed" scaleY="4%" filename="../../icons-interface/connectivity/state-red.svg" dithering="none" />

    <bitmap id="iconPlayTouch" scaleY="20%" filename="../../icons-interface/play-touch.svg" dithering="none" />
    <bitmap id="iconPauseTouch" scaleY="20%" filename="../../icons-interface/pause-touch.svg" dithering="none" />
    <bitmap id="iconNextWhite" scaleY="20%" filename="../../icons-interface/next-white.svg" dithering="none" />
    <bitmap id="iconNextBlack" scaleY="20%" filename="../../icons-interface/next-black.svg" dithering="none" />
    <bitmap id="iconPreviousWhite" scaleY="20%" filename="../../icons-interface/previous-white.svg" dithering="none" />
    <bitmap id="iconPreviousBlack" scaleY="20%" filename="../../icons-interface/previous-black.svg" dithering="none" />

</drawables>