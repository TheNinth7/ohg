<!--
    Override logo/icon sizes for Edge devices
-->
<drawables xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <bitmap id="logoOpenhabText" scaleX="60%" filename="../icons-interface/openhab-text-light.svg" dithering="none" />
    
    <!--
        Note: On Edge devices, all connection mode icons must have the same width
        for scaling to work correctly. Therefore, bluetooth-edge.svg is extended
        to match the width of wifi.svg, with empty space added to the right side
        of the icon.
    -->
    <bitmap id="iconBluetooth" scaleX="14%" filename="../icons-interface/bluetooth-edge.svg" dithering="none" />
    <bitmap id="iconWifi" scaleX="14%" filename="../icons-interface/wifi.svg" dithering="none" />
</drawables>